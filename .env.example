# Firebase Project — must match emulator: bun run dev uses --project hero-stack-local
# Use hero-stack-local for local dev; use hero-stack-gm only if you run emulator with --project hero-stack-gm
FIREBASE_PROJECT_ID=hero-stack-local
FIREBASE_API_KEY=demo-key
FIREBASE_AUTH_DOMAIN=hero-stack-local.firebaseapp.com
FIREBASE_STORAGE_BUCKET=hero-stack-local.appspot.com
FIREBASE_MESSAGING_SENDER_ID=123456789
FIREBASE_APP_ID=1:123456789:web:abc123

# Emulator mode (set false for production)
EXPO_PUBLIC_USE_EMULATOR=true
# Optional overrides (leave unset to use platform defaults)
# EXPO_PUBLIC_AUTH_EMULATOR_HOST=10.0.2.2:9099
# When USE_EMULATOR=true, FUNCTIONS_URL defaults to http://localhost:5001/<PROJECT_ID>/us-central1 (Functions v2)
# EXPO_PUBLIC_FUNCTIONS_URL=http://10.0.2.2:5001/hero-stack-local/us-central1
EXPO_PUBLIC_FIREBASE_PROJECT_ID=hero-stack-local
EXPO_PUBLIC_FIREBASE_API_KEY=demo-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=hero-stack-local.firebaseapp.com
