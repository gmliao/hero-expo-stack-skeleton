{
  "name": "hero-stack-functions",
  "version": "0.0.1",
  "main": "lib/index.js",
  "engines": {
    "node": "20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:watch": "tsc -p tsconfig.build.json --watch",
    "test": "jest --runInBand",
    "test:unit": "jest --runInBand --testPathPattern=unit.test --coverage",
    "test:integration": "jest --runInBand --testPathIgnorePatterns=unit.test --coverage=false"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5",
    "firebase-admin": "^12.0.0",
    "firebase-functions": "^6.0.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5",
    "@types/jest": "^29.0.0",
    "@types/node": "^20.0.0",
    "@types/supertest": "^6.0.2",
    "axios": "^1.6.0",
    "jest": "^29.0.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.0.0",
    "typescript": "^5.0.0"
  }
}
